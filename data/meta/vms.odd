<?xml version="1.0" encoding="UTF-8"?>
<TEI
  xmlns="http://www.tei-c.org/ns/1.0"
  xmlns:sch="http://purl.oclc.org/dsdl/schematron"
  xmlns:rng="http://relaxng.org/ns/structure/1.0">

  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title>ODD Hanslick: Die Rezensionen zu Eduard Hanslicks VMS</title>
        <author ref="https://orcid.org/0000-0002-0636-4476" role="main">Daniel Elsner</author>
	<author ref="https://orcid.org/0000-0002-8815-6741" role="contributor" xml:id="fsanzl">Fernando Sanz-Lázaro</author>
      </titleStmt>
      <publicationStmt>
        <publisher>
          <name>Austrian Centre for Digital Humanities,
            Österreichische Akademie der Wissenschaften</name>
          <ref target="https://acdh.oeaw.ac.at">https://acdh.oeaw.ac.at</ref>
        </publisher>
        <pubPlace>Wien, Österreich</pubPlace>
        <date>2023</date>
        <availability>
          <licence target="https://creativecommons.org/licenses/by/4.0/"> Attribution 4.0
                  International (CC BY 4.0)</licence>
        </availability>
        <ref type="URL"
          target="https://github.com/Hanslick-Online/hsl-data-vms/data/meta/vms.odd"
          >https://github.com/Hanslick-Online/hsl-data-vms/data/meta/vms.odd</ref>
      </publicationStmt>
      <sourceDesc>
        <p>Born digital.</p>
      </sourceDesc>
    </fileDesc>
    <revisionDesc status="draft">
      <change who="fsanzl" when="2025-10-15">Title, publisher, attList</change>          
    </revisionDesc>
  </teiHeader>

<!-- Text der ODD -->

  <text>
    <front>
      <titlePage>
        <docTitle>
          <titlePart type="main">ODD Hanslick: Die Rezensionen zu Eduard Hanslicks VMS</titlePart>
        </docTitle>
        <docAuthor type="main">Daniel Elsner</docAuthor>
        <docAuthor type="contributor">Fernando Sanz-Lázaro</docAuthor>
      </titlePage>
    </front>
    <body>
            
<!-- SCHEMA -->
      
      <div>
        
        <head>TEI-Modifikation</head>
        
        <schemaSpec ident="hsl-vms" start="TEI" xml:lang="de">
          <moduleRef key="header" include="langUsage language teiHeader fileDesc titleStmt editionStmt publicationStmt sourceDesc profileDesc encodingDesc projectDesc appInfo application editorialDecl segmentation correction normalization hyphenation interpretation punctuation revisionDesc listChange change notesStmt edition funder availability licence idno tagsDecl rendition"/>
          <moduleRef key="core" include="milestone address addrLine graphic imprint biblScope head desc l label lg list author editor title p respStmt resp noteGrp note biblStruct item listBibl bibl monogr date pubPlace publisher ref address name emph pb q quote rs add cit analytic street postCode lb hi"/>
          <moduleRef key="namesdates" include="country settlement listPerson person listPlace place forename geo location orgName persName placeName surname"/>
          <moduleRef key="tei"/>
          <moduleRef key="textstructure" include="TEI text front body back div titlePage docTitle byline docImprint titlePart docAuthor docEdition"/>
          <moduleRef key="transcr" include="facsimile surface zone"/>
          <moduleRef key="figures" include="notatedMusic"/>

          <!-- element TEI -->
          <elementSpec ident="TEI" module="textstructure" mode="change">
            <attList>
              <attDef ident="prev" mode="add" usage="opt">
                <datatype>
                  <dataRef key="teidata.pointer"/>
                </datatype>
              </attDef>
              <attDef ident="next" mode="add" usage="opt">
                <datatype>
                  <dataRef key="teidata.pointer"/>
                </datatype>
              </attDef>
            </attList>
          </elementSpec>

          <!-- element div: allow bare line-based transcriptions (text, lb, pb, hi, rs)
               directly, in addition to the standard p/head/nested-div structure, since
               the reviews are diplomatically transcribed line-by-line rather than
               segmented into paragraphs -->
          <elementSpec ident="div" module="textstructure" mode="change">
            <content>
              <alternate minOccurs="0" maxOccurs="unbounded">
                <classRef key="model.divTop"/>
                <classRef key="model.divGenLike"/>
                <classRef key="model.divLike"/>
                <classRef key="model.common"/>
                <classRef key="model.phrase"/>
                <classRef key="model.global"/>
                <textNode/>
              </alternate>
            </content>
          </elementSpec>

          <!-- element funder -->
          <elementSpec ident="funder" module="header" mode="change">
            <content>
              <alternate minOccurs="0" maxOccurs="unbounded">
                <textNode/>
                <classRef key="model.limitedPhrase"/>
                <classRef key="model.global"/>
                <elementRef key="name"/>
                <elementRef key="address"/>
              </alternate>
            </content>
          </elementSpec>
        
          <!-- element availability -->
          <elementSpec ident="availability" module="header" mode="change"/>
          
          <!-- element fileDesc -->
          <elementSpec ident="fileDesc" module="header" mode="change"/>

          <!-- element encodingDesc -->
          <elementSpec ident="encodingDesc" module="header" mode="change"/>

          <!-- element profileDesc -->
          <elementSpec ident="profileDesc" module="header" mode="change"/>

          <!-- element revisionDesc -->
          <elementSpec ident="revisionDesc" module="header" mode="change"/>
          
          <!-- element persName -->
          <elementSpec ident="persName" module="namesdates" mode="change"/>
          
          <!-- element fileDesc -->
          <elementSpec ident="placeName" module="namesdates" mode="change"/>
  
          <!-- element licence -->
          <elementSpec ident="licence" module="header" mode="change">
            <attList>
              <attDef ident="target" mode="change" usage="req">
                <valList mode="replace" type="closed">
                  <valItem ident="https://creativecommons.org/licenses/by/4.0"/>
                </valList>
              </attDef>
            </attList>
          </elementSpec>
          
          <!-- element date -->
          <elementSpec ident="date" module="core" mode="change">
            <attList>
              <attDef ident="notBefore" mode="change" usage="opt">
                <datatype>
                  <dataRef key="teidata.temporal.iso"/>
                </datatype>
              </attDef>
              <attDef ident="notAfter" mode="change" usage="opt">
                <datatype>
                  <dataRef key="teidata.temporal.iso"/>
                </datatype>
              </attDef>
              <attDef ident="when" mode="change" usage="opt">
                <datatype>
                  <dataRef key="teidata.temporal.iso"/>
                </datatype>
              </attDef>
              <attDef ident="when-iso" mode="change" usage="opt">
                <datatype>
                  <dataRef key="teidata.temporal.iso"/>
                </datatype>
              </attDef>
              <!-- custom structured-date breakdown attributes used in the
                   transcribed running text (currently placeholder "0" values,
                   pending completion of the structured dates) -->
              <attDef ident="year" mode="add" usage="opt">
                <datatype>
                  <dataRef key="teidata.enumerated"/>
                </datatype>
              </attDef>
              <attDef ident="month" mode="add" usage="opt">
                <datatype>
                  <dataRef key="teidata.enumerated"/>
                </datatype>
              </attDef>
              <attDef ident="day" mode="add" usage="opt">
                <datatype>
                  <dataRef key="teidata.enumerated"/>
                </datatype>
              </attDef>
            </attList>
          </elementSpec>
          
          <!-- element change -->
          <elementSpec ident="change" module="header" mode="change">
            <attList>
              <attDef ident="who" mode="change" usage="req">
                <valList type="closed" mode="replace">
                  <valItem ident="awilfing"/>
                  <valItem ident="delsner"/>
	          <valItem ident="fsanzl"/>
                  <valItem ident="ampfiel"/>
                </valList>
              </attDef>
              <attDef ident="when" mode="change" usage="req">
                <datatype>
                  <dataRef key="teidata.temporal.w3c"/>
                </datatype>
              </attDef>
            </attList>
          </elementSpec>
          
          <!-- element note -->
          <elementSpec ident="note" module="core" mode="change">
            <attList>
              <attDef ident="type" mode="change" usage="opt">
                <valList type="closed" mode="replace">
                  <valItem ident="mentions"/>
                  <valItem ident="foot"/>
                </valList>
              </attDef>
              <attDef ident="corresp" mode="change" usage="opt">
                <datatype>
                  <dataRef key="teidata.temporal.w3c"/>
                </datatype>
              </attDef>
              <attDef ident="target" mode="change" usage="opt">
                <datatype>
                  <dataRef key="teidata.pointer"/>
                </datatype>
              </attDef>
            </attList>
          </elementSpec>       
          
          <!-- element p -->
          <elementSpec ident="p" module="core" mode="change">
            <attList>
              <attDef ident="prev" mode="change" usage="opt">
                <datatype>
                  <dataRef key="teidata.truthValue"/>
                </datatype>
              </attDef>
            </attList>
          </elementSpec>
          
          <!-- element pb -->
          <elementSpec ident="pb" module="core" mode="change">
            <attList>
              <attDef ident="n" mode="change" usage="req">
                <datatype>
                  <dataRef key="teidata.enumerated"/>
                </datatype>
              </attDef>
              <attDef ident="facs" mode="change" usage="req">
                <datatype>
                  <dataRef key="teidata.pointer"/>
                </datatype>
              </attDef>
            </attList>
          </elementSpec>
          
          <!-- element ref -->
          <elementSpec ident="ref" module="core" mode="change">
            <attList>
              <attDef ident="target" mode="change" usage="opt">
                <datatype>
                  <dataRef key="teidata.pointer"/>
                </datatype>
              </attDef>
              <attDef ident="type" mode="change" usage="opt">
                <valList type="closed" mode="replace">
                  <valItem ident="chapter"/>
                  <valItem ident="edition"/>
                </valList>
              </attDef>
            </attList>
          </elementSpec>
          
          <!-- element rs -->
          <elementSpec ident="rs" module="core" mode="change">
            <attList>
              <attDef ident="type" mode="change" usage="req">
                <valList type="closed" mode="replace">
                  <valItem ident="person"/>
                  <valItem ident="place"/>
                  <valItem ident="bibl"/>
                </valList>
              </attDef>
              <attDef ident="ref" mode="change" usage="opt">
                <datatype>
                  <dataRef name="token" restriction="#.+"/>
                </datatype>
              </attDef>
              <attDef ident="continued" mode="add" usage="opt">
                <datatype>
                  <dataRef key="teidata.truthValue"/>
                </datatype>
              </attDef>
            </attList>
          </elementSpec>
          
          <!-- element facsimile -->
          <elementSpec ident="facsimile" module="transcr" mode="change"/>
          
          <!-- element surface -->
          <elementSpec ident="surface" module="transcr" mode="change">
            <attList>
              <attDef ident="ulx" mode="change" usage="req">
                <datatype>
                  <dataRef key="teidata.enumerated"/>
                </datatype>
              </attDef>
              <attDef ident="uly" mode="change" usage="req">
                <datatype>
                  <dataRef key="teidata.enumerated"/>
                </datatype>
              </attDef>
              <attDef ident="lrx" mode="change" usage="req">
                <datatype>
                  <dataRef key="teidata.enumerated"/>
                </datatype>
              </attDef>
              <attDef ident="lry" mode="change" usage="req">
                <datatype>
                  <dataRef key="teidata.enumerated"/>
                </datatype>
              </attDef>
            </attList>
          </elementSpec>
          
          <!-- element graphic -->
          <elementSpec ident="graphic" module="core" mode="change">
            <attList>
              <attDef ident="url" mode="change" usage="req">
                <datatype>
                  <dataRef key="teidata.pointer"/>
                </datatype>
              </attDef>
              <attDef ident="width" mode="change" usage="opt">
                <datatype>
                  <dataRef key="teidata.enumerated"/>
                </datatype>
              </attDef>
              <attDef ident="height" mode="change" usage="opt">
                <datatype>
                  <dataRef key="teidata.enumerated"/>
                </datatype>
              </attDef>
            </attList>
          </elementSpec>
          
        </schemaSpec>
      </div>
        
    </body>
      
  </text>
    
</TEI>
