        <acdh:hasContributor rdf:resource="https://orcid.org/0000-0002-7722-4091"/>
        <acdh:hasContributor rdf:resource="https://id.acdh.oeaw.ac.at/delsner"/>
        <acdh:hasCoverageStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1854-01-01</acdh:hasCoverageStartDate>
        <acdh:hasCoverageEndDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1902-12-31</acdh:hasCoverageEndDate>
        <acdh:hasSubject xml:lang="de">Digitale Edition</acdh:hasSubject>
        <acdh:hasSubject xml:lang="de">Traktat</acdh:hasSubject>
        <acdh:hasSubject xml:lang="de">Musikwissenschaft</acdh:hasSubject>
