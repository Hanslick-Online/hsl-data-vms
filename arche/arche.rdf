                    rdf:about="https://id.acdh.oeaw.ac.at/hanslick-vms/facsimiles/vom-musikalisch-schoenen-07-auflage-1885">
      <acdh:hasPid>create</acdh:hasPid>
      <acdh:hasTitle xml:lang="de">Vom Musikalisch-Schönen. Ein Beitrag zur Revision der Aesthetik der
               Tonkunst. 07. Auflage (1885)</acdh:hasTitle>
