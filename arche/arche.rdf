<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
   <acdh:TopCollection xmlns:acdh="https://vocabs.acdh.oeaw.ac.at/schema#"
                       rdf:about="https://id.acdh.oeaw.ac.at/hanslick-vms-rezensionen">
      <acdh:hasPid>create</acdh:hasPid>
      <acdh:hasTitle xml:lang="de">Die Rezensionen zu Eduard Hanslicks „Vom Musikalisch-Schönen“ (1854–1857)</acdh:hasTitle>
      <acdh:hasDescription xml:lang="de">Digitale Edition von 26 Rezensionen der ersten Auflage von Eduard Hanslicks Traktat „Vom Musikalisch-Schönen. Ein Beitrag zur Revision der Ästhetik der Tonkunst“ (1854). Die Rezensionen reichen von kurzen Berichten bis hin zu mehrteiligen Besprechungen in deutschsprachigen sowie einer englischsprachigen Zeitschrift. Sie wurden mittels Suche in digitalen Repositorien erfasst und als XML/TEI-Dateien ediert. Diese Dateien enthalten die Rezensionen selbst, annotierte Entitäten (Personen, Figuren, Werke, Orte) und werden durch aus Repositorien bezogene Faksimiles ergänzt.</acdh:hasDescription>
      <acdh:hasContact rdf:resource="https://id.acdh.oeaw.ac.at/awilfing"/>
